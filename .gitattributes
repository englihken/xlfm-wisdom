# Normalize line endings: LF in the repo for all text files, regardless of the
# committer's core.autocrlf. Without this, Windows checkouts showed 16 "modified"
# files that were pure CRLF noise (every line changed), burying real diffs.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
